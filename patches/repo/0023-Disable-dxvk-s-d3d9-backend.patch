From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrvictory1 <108172910+mrvictory1@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:26:54 +0300
Subject: [PATCH 1/3] Disable dxvk's d3d9 backend

---
 Makefile.in | 1 +
 proton      | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/Makefile.in b/Makefile.in
index b01372ef..3673158f 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -712,6 +712,7 @@ DXVK_SOURCE_ARGS = \
 DXVK_arm64ec_CFLAGS = -marm64x
 DXVK_arm64ec_LDFLAGS = -marm64x
 
+DXVK_MESON_ARGS = -Denable_d3d9=false
 DXVK_i386_MESON_ARGS = --bindir=$(DXVK_i386_DST)/lib/wine/dxvk/i386-windows
 DXVK_x86_64_MESON_ARGS = --bindir=$(DXVK_x86_64_DST)/lib/wine/dxvk/x86_64-windows
 DXVK_arm64ec_MESON_ARGS = --bindir=$(DXVK_arm64ec_DST)/lib/wine/dxvk/aarch64-windows
diff --git a/proton b/proton
index 0b51c252..5c24b3de 100755
--- a/proton
+++ b/proton
@@ -1169,7 +1169,7 @@ class CompatData:
                     vkd3d_protonfiles = []
                     wined3dfiles = ["d3d12", "d3d11", "d3d10", "d3d10core", "d3d10_1", "d3d9"]
                 else:
-                    dxvkfiles = ["d3d11", "d3d10core", "d3d9"]
+                    dxvkfiles = ["d3d11", "d3d10core"]
                     vkd3d_protonfiles = ["d3d12", "d3d12core"]
                     wined3dfiles = []
 
