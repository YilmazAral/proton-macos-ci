From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mrvictory1 <108172910+mrvictory1@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:31:44 +0300
Subject: [PATCH 3/3] Makefile.in: specify freetype include directory for wine

---
 Makefile.in | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Makefile.in b/Makefile.in
index 8b274ac2..7417addd 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -638,6 +638,7 @@ WINE_x86_64_AUTOCONF_ARGS += \
   VKD3D_PE_CFLAGS="-I$(VULKAN_HEADERS_x86_64_DST)/include -I$(VKD3D_x86_64_DST)/include/vkd3d" \
   VKD3D_PE_LIBS="-L$(VKD3D_x86_64_LIBDIR) -lvkd3d -lvkd3d-shader -lvkd3d-utils"
 
+WINE_CFLAGS = -I/usr/local/include/freetype2
 WINE_DEPENDS = gst_orc gstreamer gst_base ffmpeg openfst kaldi vosk
 WINE_i386_DEPENDS = vkd3d
 WINE_x86_64_DEPENDS = piper vkd3d
